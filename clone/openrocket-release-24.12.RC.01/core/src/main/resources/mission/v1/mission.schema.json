{
  "type": "object",
  "properties": {
    "format": {
      "const": "openrocket.mission"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "identity": {
      "type": "object",
      "properties": {
        "missionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "missionId",
        "title",
        "revision"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rocket",
              "fc",
              "motor",
              "behavior",
              "codec",
              "slate",
              "geoid"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "kind",
          "reference"
        ]
      }
    },
    "flight": {
      "type": "object"
    },
    "vehicleBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          },
          "rocketAssetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "launch-site",
              "launch",
              "gs1",
              "gs2",
              "gs3",
              "gs4"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "enabled": {
            "type": "boolean"
          },
          "latitudeDeg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitudeDeg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "heightM": {
            "type": [
              "number",
              "null"
            ]
          },
          "heightDatum": {
            "type": "string",
            "enum": [
              "MSL",
              "ellipsoidal"
            ]
          },
          "coordinateInput": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "mgrs",
                  "latlon"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 160
              },
              "reference": {
                "type": "string",
                "enum": [
                  "grid-point",
                  "cell-center",
                  "point"
                ]
              },
              "precisionM": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "format",
              "reference"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "latitudeDeg",
          "longitudeDeg",
          "heightM",
          "heightDatum",
          "coordinateInput"
        ]
      },
      "minItems": 2,
      "maxItems": 6
    },
    "pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          },
          "siteId": {
            "type": "string",
            "enum": [
              "gs1",
              "gs2",
              "gs3",
              "gs4"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "targetVehicleId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          },
          "trackingPolicy": {
            "type": "string",
            "enum": [
              "legacy-ui.v1",
              "geodetic.v1",
              "truth-benchmark.v1"
            ]
          },
          "initialAzimuthDeg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "initialElevationDeg": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "azimuthRateDegS": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "elevationRateDegS": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "mountHeightM": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "id",
          "siteId",
          "enabled",
          "targetVehicleId",
          "trackingPolicy",
          "initialAzimuthDeg",
          "initialElevationDeg",
          "azimuthRateDegS",
          "elevationRateDegS",
          "mountHeightM"
        ]
      },
      "maxItems": 4
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "standard",
            "custom-fc"
          ]
        },
        "formatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fallback": {
          "type": "string",
          "enum": [
            "legacy",
            "require-format"
          ]
        },
        "rateHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "mode",
        "formatId",
        "fallback",
        "rateHz",
        "links"
      ]
    },
    "video": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "Balius",
            "Iris",
            "Custom"
          ]
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
              },
              "vehicleId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "analog",
                  "digital"
                ]
              },
              "receivers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "launch",
                    "gs1",
                    "gs2",
                    "gs3",
                    "gs4"
                  ]
                },
                "maxItems": 5
              }
            },
            "required": [
              "id",
              "vehicleId",
              "kind",
              "receivers"
            ]
          }
        }
      },
      "required": [
        "preset",
        "streams"
      ]
    },
    "stationBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$(?![\\s\\S])"
          },
          "siteId": {
            "type": "string",
            "enum": [
              "launch",
              "gs1",
              "gs2",
              "gs3",
              "gs4"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "telem",
              "video"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "headless-policy",
              "interactive-ui",
              "observer"
            ]
          }
        },
        "required": [
          "id",
          "siteId",
          "role",
          "owner"
        ]
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ground-link",
            "coupled",
            "interactive"
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
        },
        "deliveryTailUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,7})$(?![\\s\\S])"
        },
        "ensemble": {
          "type": "object"
        }
      },
      "required": [
        "mode",
        "seed",
        "deliveryTailUs",
        "ensemble"
      ]
    },
    "outputs": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "identity",
    "assets",
    "flight",
    "vehicleBindings",
    "sites",
    "pointers",
    "telemetry",
    "video",
    "stationBindings",
    "execution",
    "outputs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrocket:mission:configuration:1",
  "title": "Mission configuration v1 draft envelope",
  "description": "A1 envelope. Flight snapshots, codec layouts, links and output policies are preserved objects; later stages add their complete executable validation. Loading this draft never authorizes execution."
}
